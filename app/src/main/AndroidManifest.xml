<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 后台运行：常驻前台服务（targetSdk 28，不需要 foregroundServiceType） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 悬浮球：悬浮窗权限（用户需在系统设置里手动允许） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 存储：targetSdk 28 走 legacy 外部存储，授予后 /sdcard 可全盘读写（Android 14 待装机实测） -->
    <!-- 不加 maxSdkVersion：声明后会使 Android 13+ 视为未申请，pm grant 报 has not requested -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- 通知（Android 13+ 才弹框，targetSdk 28 上声明无副作用） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 任务结果渠道要走横幅+振动；没有这条权限系统会静默吞掉振动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 保活：请求忽略电池优化（设置｜权限管理页一键跳转） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 后续在 App 内装 APK（插件/更新） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 定时任务：开机与应用更新后重排闹钟（国产 ROM 还需用户在系统设置里允许自启动） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 定时任务：Android 12+ 精确闹钟；同时声明 USE_EXACT_ALARM，供 Android 13+ 装机即授予 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 定时任务：执行期间持有部分唤醒锁，避免设备进入 Doze 后中断任务 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Shizuku：动态授权的 shell 通道（见 infra/system/ShizukuBridge.kt） -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 允许 http 明文：web_fetch 抓 http 页面、以及后续连本机 dsh 面板（http://127.0.0.1:…）都要用 -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.Agent">
        <!-- configChanges：系统切深浅色时不重建 Activity，否则 Activity 重建会丢失 ChatViewModel 中的会话状态 -->
        <!-- launchMode=singleTop：从其它应用分享时复用栈顶实例并走 onNewIntent，不叠加新任务 -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|density|fontScale"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 系统分享入口：文字、图片与文件必须分多组 filter，写在同一个里会互相污染类型匹配；
                 文字用 text/* 而不是 text/plain：文件管理器分享 .md/.html 等文本文件时类型是
                 text/markdown、text/html，只声明 text/plain 会让本应用在分享面板里直接消失。
                 application/* 承接 pdf、docx、xlsx、pptx、zip 等文档与压缩包。
                 图片与文件同时接受 SEND_MULTIPLE：相册多选与文件多选分享走的是这个 action，缺了它同样不出现。
                 仍不复用 */*：音频、视频、安装包等本应用不处理，列出来只会误导。
                 分享进来后主页进入「分享模式」：底部输入区临时换成分享面板，发送完即退场。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".feature.terminal.TerminalActivity"
            android:exported="false"
            android:theme="@style/Theme.Agent.Terminal"
            android:windowSoftInputMode="adjustNothing" />

        <!-- 常驻前台服务：让进程退到后台后不被轻易回收 -->
        <service
            android:name=".capability.runtime.AgentForegroundService"
            android:exported="false" />

        <!-- 悬浮球：TYPE_APPLICATION_OVERLAY 悬浮窗 -->
        <service
            android:name=".feature.float.FloatingBallService"
            android:exported="false" />

        <!-- 定时任务：AlarmManager 到点后由它转发给 ScheduleRunner；exported=false，只有本 App 的闹钟能发进来 -->
        <receiver
            android:name=".feature.schedule.ScheduleReceiver"
            android:exported="false" />

        <!-- 定时任务：开机完成 / 应用覆盖更新后重排闹钟；exported=false，系统广播仍可送达 -->
        <receiver
            android:name=".feature.schedule.ScheduleBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Shizuku：provider 必须有，Shizuku 应用才认这个客户端；V3_SUPPORT 开新版 binder 协议 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <!-- 预览页的「用其他应用打开」：缓存副本经 FileProvider 授权读取，file:// 会被系统直接拒掉 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>